<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>History</title>
    <style>
        .history-upbar{
            width: 100%;
            height: 70px;
            top:20px;
            position: fixed;
            background-color: aqua;
            display: flex;
            justify-content: center;
            align-items: center;
            /* z-index: 10; */
        }
        .history-main{
            min-height: 100%;
            display:flex;
            background-color:rgb(233, 233, 241);


        }

        .history-sidebar{
            height:100%;
            width:300px;
            background-color: aliceblue;
            left :0px;
            position:fixed;
            z-index: 5;
            display:flex;
            align-items: center;
            justify-content: center;
            
        
        }
        .history-container {
            margin-top:100px; /* Account for the upbar height */
            margin-left: 400px; /* Account for the sidebar width */
            padding: 20px;
            width:800px;
            background-color: rgb(255, 255, 255);
            height:500px;
            z-index: 1;
        }

        .border-line{
            width:100%;
            height: 2px;
            background-color: rgb(150, 146, 146);
        }
        

    </style>

</head>
<body>
    
    
    <div class="history-sidebar">
       <p>hello </p>


    </div>
    
    <div class="history-main">

        <div class ="history-upbar">
            <p style=" text-align: center ; font-size: 30px; font-weight: bold;"> History Journal<p>
           
    
        </div>
    
      
    
        <div class="history-container">
           <input id="symptom-title" type="text" placeholder="title" style="width:100%; height: 50px; font-size: 25px; border:none; outline:none;">
           <div class="border-line"></div>
           <div class="calender" style="margin-top: 10px; ">
               <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span id="currentdate" style="font-size: 20px; margin-left: 10px;">  </span>

           </div>
           <div class="border-line"></div>
           <textarea name="description" id=" describe" placeholder="describe how you feel" style="width:100%; height: 300px; border:none; outline:none;margin-top: 10px; font-size: 16px;"></textarea>
        </div>
    </div>
 

    <script src="/historyscript.js"> </script>
</body>
</html>