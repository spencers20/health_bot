<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>History</title>
    <style>
        .history-upbar{
            width: 100%;
            height: 70px;
            /* top:20px; */
            position: fixed;
            background-color: aqua;
            display: flex;
            /* justify-content: center;
            align-items: center; */
            /* z-index: 10; */
        }
        .history-main{
            min-height: 100%;
            display:flex;
            background-color:rgb(233, 233, 241);

        }

        .history-sidebar{
            height:100%;
            width:300px;
            background-color: aliceblue;
            left :0px;
            position:fixed;
            z-index: 5;
            /* display:flex; */
            /* align-items: center; */
            /* justify-content: center; */
            
        
        }
        .history-container {
            margin-top:100px; /* Account for the upbar height */
            margin-left: 400px; /* Account for the sidebar width */
            padding: 20px;
            width:800px;
            background-color: rgb(255, 255, 255);
            height:500px;
            z-index: 1;
        }

        .border-line{
            width:100%;
            height: 2px;
            background-color: rgb(150, 146, 146);
        }
        .entries{
            display: flex;
            
            margin-top: 10px;
            margin-right: 20px;
            cursor: pointer;
           
            border-bottom-style: solid;
            border-bottom-width: thin;
            height: 35px;
            /* border-right-style: solid;
            border-right-width:thin; */
            /* width:%; */
            
        }

    </style>

</head>
<body>
    
    
    <div class="history-sidebar">
        <div style="top:0px; height: 70px; align-items: center; display:flex; flex-direction: column; border-bottom-style: solid; border-bottom-width: thin;margin-right: 20px;">
            <p style="font-size:20px ;margin-bottom:1px;">MY Health Journal</p>
            <p style="font-size: 14px;margin-top: 0px;"> keep record of your wellbeing</p>
        </div>

        <div id="newentry" class="entries">
            <svg  style="margin-bottom:10px; margin-left:20px "xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <!-- Circle -->
                <circle cx="12" cy="12" r="10"></circle>
                <!-- Vertical Line of Plus -->
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <!-- Horizontal Line of Plus -->
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              

              <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;"> New entry</span>
              

        </div>

        <div class="entries" >
            <svg style="margin-left:20px"xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <!-- First Line -->
                <line x1="4" y1="7" x2="20" y2="7"></line>
                <!-- Second Line -->
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <!-- Third Line -->
                <line x1="4" y1="17" x2="20" y2="17"></line>
              </svg>

              <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;"> View Entire History</span>
              
        </div>

        <div class="entries" >
            <svg style="margin-left:20px" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
              

              <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;"> Starred History</span>
              
        </div>

        <div class="entries" onclick="window.location.href='/user/symptomchecker'">
            <svg  style="margin-left:20px"xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="24" height="24">
                <!-- Clipboard -->
                <rect x="12" y="4" width="40" height="56" rx="4" ry="4" fill="#f0f0f0" stroke="#000" stroke-width="2"/>
                <rect x="12" y="4" width="40" height="10" rx="2" ry="2" fill="#a0a0a0"/>
                
                <!-- Checkmark -->
                <path d="M20 32l8 8 16-16" stroke="#28a745" stroke-width="4" fill="none"/>
              </svg>   
              
              
              
 
              <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;"> Check Symptom</span>
              
        </div>



    </div>
    
    <div class="history-main">

        <div class ="history-upbar">

            <p style=" margin-left:600px; text-align: center ; font-size: 30px; font-weight: bold;"> myafya365
                <p>
            <p style="margin-left:400px; font-size:20px"> <%=user.name%></p>

    
    
        </div>
    
      
    
        <div class="history-container">
            <div style="display:flex; justify-content: space-between; width:100%;" > 
                <input id="symptom-title" type="text" placeholder="title" style=" height: 50px; font-size: 25px; border:none; outline:none;">
                <span  id="save" style="font-size:18px; color:blue; cursor:pointer"> 
                    save
                </span>
            </div>
           <div class="border-line"></div>
           <div class="calender" style="margin-top: 10px; ">
               <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span id="currentdate" style="font-size: 20px; margin-left: 10px;">  </span>

           </div>
           <div class="border-line"></div>
           <textarea  id="describe"name="description"  placeholder="describe how you feel" style="width:100%; height: 300px; border:none; outline:none;margin-top: 10px; font-size: 16px;"></textarea>
        </div>
    </div>
 

    <script src="/historyscript.js"> </script>
</body>
</html>