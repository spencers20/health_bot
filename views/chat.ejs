<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Myafya</title>
    <link rel="stylesheet" type="text/css" href="/styles.css">
    <style>
    
    * {
        box-sizing: border-box;
        /* margin: 0; */
        /* padding: 0; */
        font-family: Arial, sans-serif;
    }    
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: white;
        color: #333;
        /* overflow: hidden; */
        overscroll-behavior: none;
    }

    .main-body{
        width:100%;
        background-color:rgb(233, 233, 241) ;
        display:flex;
        flex-direction: row;
        margin-top:20px
    }
    .side-bar {
        width:23%;
        background-color: aliceblue;
        padding: 10px;
        display: flex;
        flex-direction: column;
        margin-left:20px;
        margin-top:30px;
        height:450px;
        position: fixed;
        border-radius:12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        /* z-index: 5; */
       

    }

    .tip-image, .tip-description{
    font-size: 15px;
    margin-top:30px;
    object-fit: contain;
    width: 100%; 
    height: auto; 
    }


    #edit-value:hover::after {
    content: "edit value"; /* Correct way to add text */
    /* position: absolute; */
    background-color: rgba(66, 65, 65, 0.7); /* Optional: Tooltip background */
    color: white;
    padding: 5px ;
    font-size: 12px;
    border-radius: 5px;
    white-space: nowrap;
    top: 100%; /* Position below the element */
    left: 50%;
    transform: translateX(-50%);
     }
     .containermetric{
        height: 180px; 
        width: 150px; 
        display: flex;
        background-color: #e0f7fa; 
        border-radius: 10px; 
        box-shadow: 0 5px 10px black; 
        flex-direction: column; 
        padding: 10px;
        margin-left: 20px;
        padding: 5px;
    }

    .symptomcheck{
        margin-top:30px;
        width:100%;
        display: flex;
        border-radius: 12px;
        background-color: #f7f7f7;
        box-shadow: 0 4px 8px rgb(15, 15, 15);
        flex-direction: row;
        padding:10px;
        margin-left: 50px;
        align-items: center;
        justify-content: center;
        min-height: 100px;
    }

   




 
    .profile-icon {
        background-color: #000;
        color: #fff;
        width: 30px;
        height: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
    }


    .main-content {
        flex: 1;
        padding: 40px;
        background-color: #fff;
        text-align: center;
    }

    .main-content h1 {
        font-size: 36px;
        margin-bottom: 10px;
    }

    .upgrade {
        font-size: 14px;
        color: #888;
    }

    .upgrade a {
        color: #007bff;
        text-decoration: none;
    }

    .search-bar {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
    }

    .search-bar input {
        width: 300px;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .send-btn {    
        padding: 10px 15px;
        border: none;
        color: #fff;
        border-radius: 5px;
        cursor: pointer;
    }

    .suggestions button {    
        margin: 5px;
        padding: 10px;
        background-color: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 5px;
        cursor: pointer;
    }
    .response {
        align-self: flex-start;
        background-color:#fcfdf9 ;
        margin-top: 20px;
        padding: 10px;
        border-radius:  5px;
        max-width: 95%;


    }

    .userMessage {
        align-self: flex-start;
        background-color: #e9ebec;
        font-weight: bold;
        padding:10px;
        border-radius: 5px;
        max-width: 50%;

    }

    .bottom-input {
      position: absolute;
      bottom: 20px;
    }


    .container {
      /* display: flex; */
      flex:1;
      flex-direction: column;
      padding:40px;
      align-items: center;
      text-align: center;
      transition: all 0.5s ease;
      overscroll-behavior: contain;
    }

    #chat-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height:550px;
    overflow-y: auto;
    padding: 10px;
    overscroll-behavior: contain;
    /* padding-bottom: 10px; */
    /* border: 1px solid #ccc; */
}
  

    footer {
        margin-top: 20px;
        font-size: 12px;
    }

    footer a {
        color: #888;
        text-decoration: none;
        margin: 0 5px;
    }

    footer a:hover {
        text-decoration: underline;
    }

    
    </style>
</head>
<body>

