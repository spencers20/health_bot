<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Myafya</title>
    <link rel="stylesheet" type="text/css" href="/styles.css">
    <style>
    
    * {
        box-sizing: border-box;
        /* margin: 0; */
        /* padding: 0; */
        font-family: Arial, "Segoe UI", "Noto Color Emoji", sans-serif;
        
    }    
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color:rgb(235, 234, 234); 
        color: #333;
        /* overflow: hidden; */
        overscroll-behavior: none;
    }

    .main-body{
        width:100%;
        background-color:rgb(242, 248, 248) ;
        display:flex;
        flex-direction: row; 
        margin-top:10px;
      
    }

    .side-bar{
        width: 23%;
        margin-top:30px;
        display: flex;
        flex-direction: column;
        position: fixed;
        height:550px;
        margin-left:20px;


    }
    .side-card {
        width:100%;
        background-color: aliceblue;
        padding: 10px;
        display: flex;
        flex-direction: column; 
        margin-top:30px;
        height:450px; 
        border-radius:12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        /* z-index: 5; */
       

    }

    .tip-image, .tip-description{
    font-size: 15px;
    margin-top:30px;
    object-fit: contain;
    width: 100%; 
    height: auto; 
    }


    .edit-svg:hover::after {
    content: "edit value"; /* Correct way to add text */
    /* position: absolute; */
    background-color: rgba(66, 65, 65, 0.7); /* Optional: Tooltip background */
    color: white;
    padding: 5px ;
    font-size: 12px;
    border-radius: 5px;
    white-space: nowrap;
    top: 100%; /* Position below the element */
    left: 50%;
    transform: translateX(-50%);
     }

     .edit-value:hover ~ .card-metric-content {
    opacity: 0; /* Set opacity to 0 for the targeted container when hovering over the edit icon */
    transition: opacity 0.3s ease; /* Smooth transition */
}


     .card-metric{
        height: 180px; 
        width: 150px; 
        display: flex;
        background-color:#fafaf7; 
        border-radius: 10px; 
        box-shadow: 0  2px 5px rgb(173, 172, 172); 
        flex-direction: column; 
        padding: 10px;
        margin-left: 20px;
        padding: 5px;
        transform: box-shadow 1.5s ease;
       
    }

    .card-metric:hover{
        box-shadow: 0  7px 14px rgb(122, 122, 122); 
       
    }

    .lowerpart{
        padding: 10px;
        align-self: center;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    .lowerpart:hover::after{
        content: attr(card-tip);
        background-color:rgba(66, 65, 65, 0.7) ;
        color:rgb(255, 255, 255);
        top:100%;
        border-radius: 12px;
        padding:5px;
        font-size:12px ;
        white-space: nowrap;
        margin-top: 10px;
        /* left:50%; */
        /* transform: translateX(-50%); */

    
    }

    .card-pages{
        margin-top:30px;
        width:100%;
        display: flex;
        border-radius: 12px;
        background-color: #fafaf7;
        box-shadow: 0 1px 3px rgb(173, 172, 172); 
        flex-direction: row;
        padding:10px;
        margin-left: 50px;
        align-items: center;
        justify-content: center;
        min-height: 100px;
        transform: box-shadow 1.5s ease;
        
    }

    .card-pages:hover{
        box-shadow: 0  3px 6px rgb(133, 132, 132); 
       
    }

    .metric-middle{
        display: flex; 
        align-items:center;
        justify-content: center; 
        flex-direction: column; 
        align-self: center;
        margin-top: 10px;
        cursor: pointer;
    }

    .metric-middle:hover::after{
        content: attr(metric-tip);
        font-size:12px;
        color:#40069e;
        /* background-color: rgba(104, 103, 103, 0.7); */
        border-radius: 12px;
        padding: 2px;
        flex-direction: row;
        top:100%
        /* padding:10px; */

    }

    
    .profile-icon {
        background-color: #000;
        color: #fff;
        width: 30px;
        height: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
    }

  
    

  

    

    .userMessage {
        align-self: flex-start;
        background-color:#52d7db;
        font-weight: bold;
        padding:10px;
        border-radius: 5px;
        max-width: 50%;

    }

    .bottom-input {
      position: absolute;
      bottom: 20px;
    }


    .container {
      /* display: flex; */
      flex:1;
      flex-direction: column;
      padding:40px;
      align-items: center;
      text-align: center;
      transition: all 0.5s ease;
      overscroll-behavior: contain;
    }

    #chat-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height:550px;
    overflow-y: auto;
    padding: 10px;
    overscroll-behavior: contain;
    /* padding-bottom: 10px; */
    /* border: 1px solid #ccc; */
}
  

    footer {
        margin-top: 20px;
        font-size: 12px;
    }

    footer a {
        color: #888;
        text-decoration: none;
        margin: 0 5px;
    }

    footer a:hover {
        text-decoration: underline;
    }

    
    </style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar/index.global.min.js'></script>

</head>
<body>

    <div class="head" style=" position: sticky; display :flex; width:100%; height: 40%;  top:0;background-color: rgb(235, 234, 234);   border-bottom: 1px solid rgb(235, 234, 234);">
        <div style=" display :flex;  width: 100%; font-size: 25px; justify-content: center; align-items: center; height:90px;font-weight: 600;">
            Myafya
        </div>
    </div>
  
    <div class="main-body" >
        <div class="side-bar">
            <span style="font-size: 20px; color: #888281;">
                Good Morning, <%=user.name.split(" ")[1]?user.name.split(" ")[1]:user.name%>!
            </span>

            <div class="side-card" >
    
                <span  style="align-self: center; margin-top: 10px; font-size: 10px;font-size:20px; font-weight: 600;">
                    Did you Know?
                </span>
                <span class="tip-description" >
                        <!-- A balanced diet includes a variety of fruits, vegetables, whole grains, lean proteins, and healthy fats. It can help keep your body healthy and prevent chronic diseases. -->
                </span>
                    <img class="tip-image" alt="">
                    
            </div>

        </div>
       

        <div class="side-body" style="display: flex; flex-direction: column; margin-left:27%; ">
            <div class="disclaimer" style="display: flex;flex-direction: row;margin-left:50px;padding: 10px;align-items: center;justify-content: center;">
                <span>

                    <svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="35px" height="35px" viewBox="0 0 24 24" id="warning" data-name="Line Color" class="icon line-color">
                        <script xmlns=""/>
                        <circle id="primary" cx="12" cy="12" r="9" style="fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"/>
                        <line id="secondary" x1="12" y1="7" x2="12" y2="13" style="fill: none; stroke: rgb(188, 130, 44); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"/>
                        <line id="secondary-upstroke" x1="12.05" y1="17" x2="11.95" y2="17" style="fill: none; stroke: rgb(188, 130, 44); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"/>
                        <script xmlns=""/>
                    </svg>
                </span>

                    <span style="color:rgb(44, 169, 188);font-size: 14px; margin-left: 20px;"> Please ensure that all filled values have been measured and approved by your healthcare provider.</span>

            </div>
        
            <div  style="margin-left: 40px; margin-top: 20px; width:100%;  display: flex; flex-direction: row;">

                <div class="card-metric" card-id="temperature"  >
                    <div  class="edit-value" style="display: flex; flex-direction: row;  cursor: pointer;width: 90%;" >
                        <div class="back-svg" style="opacity: 0;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 1024 1024"><script xmlns=""/>
                                <path fill="#000000" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z"/><path fill="#000000" d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z"/><script xmlns=""/></svg>
                            </div>
                        <div  class="edit-svg" style="margin-left: 80px;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" viewBox="0 0 20 20" fill="none">
                                <path stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.8 12.963L2 18l4.8-.63L18.11 6.58a2.612 2.612 0 00-3.601-3.785L3.8 12.963z"/>
                              <script xmlns=""/></svg>
                            </div>    
                        </div>
                    <div class="metric-middle"card-id="temperature" metric-tip="view temp. trend" >
                        <span style="margin-top:5px; align-self: center; font-size: 18px;">Temperature</span>
                        <span id="tempvalue" style="font-size: 30px; align-self: center; margin-top: 10px; display: flex;">37 &deg;c</span>
                        <span id="conditiondegree" style="font-size: 15px;margin-top:10px; align-self:center"  >Normal</span>
                    </div>

                    <div class="inputvalues"  style="display: none;  flex-direction: column; ">
                        <span style="align-self: center; margin-top: 10px;">Temperature</span>
                        <input class="value-input" input-id="" style="font-size:20px;align-self: center; border:none; height:40px;width:100px; margin-top:10px; text-align: center; "  type="text" placeholder="37">
                    </div>
                </div>
                <div class="card-metric" card-tip="view B.Pressure trend"   >
                    <div  class="edit-value" style="display: flex; flex-direction: row;  cursor: pointer;width: 90%;" >
                        <div class="back-svg" style="opacity: 0;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 1024 1024"><script xmlns=""/>
                                <path fill="#000000" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z"/><path fill="#000000" d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z"/><script xmlns=""/></svg>
                            </div>
                        <div  class="edit-svg" style="margin-left: 80px;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" viewBox="0 0 20 20" fill="none">
                                <path stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.8 12.963L2 18l4.8-.63L18.11 6.58a2.612 2.612 0 00-3.601-3.785L3.8 12.963z"/>
                              <script xmlns=""/></svg>
                            </div>    
                        </div>
                    
                    <div class="metric-middle"  card-id="pressure" metric-tip="view B.Pressure trend"  >
                        <span style="margin-top:5px; align-self: center; font-size: 18px;">Blood Pressure</span>
                        <span id="tempvalue" style="font-size: 25px; align-self: center; margin-top: 10px; display: flex;">120/88 <p style="font-size: 14px; margin-left: 2px;"> mm Hg</p></span>
                        <span id="conditiondegree" style="font-size: 15px;margin-top:10px; align-self:center"  >Normal</span>
                    </div>
                    <div class="inputvalues"  style="display: none;  flex-direction: column;">
                        <span style="align-self: center; margin-top: 5px;">Systolic</span>
                        <input class="sysvalueinput" input-id="syst" style="font-size:20px;align-self: center; border:none; height:30px;width:100px; margin-top:10px; text-align: center; "  type="text" placeholder="120">
                        <span style="align-self: center; margin-top: 5px;">Diastolic</span>
                        <input class="value-input" input-id="dias" style="font-size:10px;align-self: center; border:none; height:30px;width:100px; margin-top:10px; text-align: center; "  type="text" placeholder="88">

                    </div>

                   

                </div>
                <div class="card-metric" card-tip="view pulse trend"   >
                    <div  class="edit-value" style="display: flex; flex-direction: row;  cursor: pointer;width: 90%;" >
                        <div class="back-svg" style="opacity: 0;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 1024 1024"><script xmlns=""/>
                                <path fill="#000000" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z"/><path fill="#000000" d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z"/><script xmlns=""/></svg>
                            </div>
                        <div  class="edit-svg" style="margin-left: 80px;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" viewBox="0 0 20 20" fill="none">
                                <path stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.8 12.963L2 18l4.8-.63L18.11 6.58a2.612 2.612 0 00-3.601-3.785L3.8 12.963z"/>
                              <script xmlns=""/></svg>
                            </div>    
                        </div>
                    
                    <div class="metric-middle"  card-id="pulse" metric-tip="view Pulse trend">
                    <span style="margin-top:5px; align-self: center; font-size: 18px;">Pulse Rate</span>
                    <span id="tempvalue" style="font-size: 30px; align-self: center; margin-top: 10px; display: flex;">70 bpm</span>
                    <span id="conditiondegree" style="font-size: 15px;margin-top:10px; align-self:center"  >Normal</span>
                    
                </div>
                <div class="inputvalues"  style="display: none;  flex-direction: column; ">
                    <span style="align-self: center; margin-top: 10px;">Pulse Rate</span>
                    <input class="value-input" input-id="" style="font-size:20px;align-self: center; border:none; height:40px;width:100px; margin-top:10px; text-align: center; "  type="text" placeholder="70">
                </div>
            </div>
                <div class="card-metric" card-tip="view Respiratory trend" >
                  <div  class="edit-value" style="display: flex; flex-direction: row;  cursor: pointer;width: 90%;" >
                        <div class="back-svg" style="opacity: 0;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="15px" height="25px" viewBox="0 0 1024 1024"><script xmlns=""/>
                                <path fill="#000000" d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z"/><path fill="#000000" d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z"/><script xmlns=""/></svg>
                            </div>
                        <div  class="edit-svg" style="margin-left: 80px;" >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" viewBox="0 0 20 20" fill="none">
                                <path stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.8 12.963L2 18l4.8-.63L18.11 6.58a2.612 2.612 0 00-3.601-3.785L3.8 12.963z"/>
                              <script xmlns=""/></svg>
                            </div>    
                        </div>
                    
                    <div class="metric-middle"  card-id="respiratory" metric-tip="view Respiratory trend">
                        <span style="margin-top:5px; align-self: center; font-size: 18px;">Respiratory Rate</span>
                        <span id="tempvalue" style="font-size: 30px; align-self: center; margin-top: 10px; display: flex;">15 bpm</span>
                        <span id="conditiondegree" style="font-size: 15px;margin-top:10px; align-self:center"  >Normal</span>
                    </div>
                    <div class="inputvalues"  style="display: none;  flex-direction: column; ">
                        <span style="align-self: center; margin-top: 10px;">Respiratory Rate</span>
                        <input class="value-input" input-id="" style="font-size:20px;align-self: center; border:none; height:40px;width:100px; margin-top:10px; text-align: center; "  type="text" placeholder="37">
                    </div>
                

                </div>
            </div>

            <div class="card-pages symptom-check" >
                <div style="align-items: center; justify-content: center;">
