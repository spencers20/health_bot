    <body>
          <!-- custom-alert -->
    <%- include('alert') %>

        <header>
            <div id="docgreeting">Welcome Back, Doctor</div>
            <div style="display: flex;width: 100px;height: 100px;align-items: center;justify-content: center;overflow: hidden;">
                <img src="/logo/Pink Green Simple Modern Health Center Logo.png" 
                     alt="Afyasphere Logo" 
                     style="width: 180%;height: 180%;object-fit: cover;margin-top: 20px;">
            </div>
            <div class="logout">Log Out</div>
        </header>

        <!-- <div style="display: flex;flex-direction: row;"> -->

        <div class="main-doc" style="display: flex;flex-direction: row;gap:10px;">
            
            <div class="appointment-report" style="display: flex;flex-direction: column;width: 70%;">
                <div class="main-header">
                    <div class="legend-card">
                        <div class="card-summary" >
                         
                            <div style="display: flex;flex-direction: row;">
                                <div class='the-card'>
                                    <span>Today's appointments</span>
                                    <span id="todayno" style="margin-top:10px">0</span>
    
                                </div>
    
                                <div class='the-card'>
                                    <span>Upcoming Appointments</span>
                                    <span  id="upcomingappoints" style="margin-top:10px"> 0</span>
    
                                </div>
    
                                <div class='the-card'>
                                    <span>Pending Reports</span>
                                    <span id="pendingrepocount" style="margin-top:10px"> 0</span>
    
                                </div>
                                <div style="align-items: center;padding:auto; margin: 5px; display: flex; flex-direction: column;">
                                    <label style="display: flex;flex-direction: row;margin: 5px;margin-top: 13px; padding:5px;border-radius: 5px;">
                                        <input class="availability" style="margin: 5px;padding: 3px;" type="radio" name="availability" value="active" id="active"> Active
                                    </label>
                                    <label style="display: flex;flex-direction:row;margin: 5px;padding: 5px;font-size: 16px;;border-radius: 5px;">
                                        <input class="availability" style="margin: 5px;padding: 3px;" type="radio" name="availability" value="away" id="away" checked>Away
                                    </label>
                                    
                                </div>
                              
    
                            </div>
                        </div>
                        <div id="docimages" style="border-radius: 30px;  height:auto ;width: 40%; margin-left: 10px;  background-size: cover;background-position: 50% 20% ; background-image: url('https://img.freepik.com/free-photo/beautiful-young-female-doctor-looking-camera-office_1301-7807.jpg') ">
                          
                        </div>
    
    
                    </div>

                </div>

                <div class="the-container">
    
                    <!-- Appointments Section -->
                    <div class="container Appointments" style="width: 45%; padding: 5px; background: #fff; border-radius: 12px;   box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);max-height: 60vh;overflow-y: auto; ">
                        <div style="position: sticky; top: 0; background: white; padding: 10px 0; font-size: 17px; font-weight: 600; text-align: center; border-bottom: 2px solid #ddd; z-index: 10;">
                            Appointments
                      
                        
                        <div id="appointment-tabs" style="display: flex; justify-content: center; gap: 40px; font-weight: 500; margin: 10px 0; cursor: pointer;">
                            <span class="appointment-tab active" onclick="selectTab(this, 'allappoints')">All</span>
                            <span class="appointment-tab" onclick="selectTab(this, 'todayappoints')">Today</span>
                            <!-- <span class="appointment-tab" onclick="selectTab(this, 'pendingappoints')">Pending</span> -->
                            <span class="appointment-tab" onclick="selectTab(this, 'upcomingappoints')">Pending</span>
                        </div>
                    </div>
                        
                
                        <div style=" overflow-y: auto; padding: 5px;">
                            <div class="appointments" style="display: flex; flex-direction: column; height: 400px; "> </div>
                        </div>
                    </div>
                
                    <!-- Reports Section -->
                    <div class="container Reports" style="width: 50%; margin-left: 30px; padding: 5px; background: #fff; border-radius: 12px; box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1); max-height: 60vh;overflow-y: auto;">
                        <div style="position: sticky; top: 0; background: white; padding: 10px 0; font-size: 16 px; font-weight: 600; text-align: center; border-bottom: 2px solid #ddd; z-index: 10;">
                            Reports
                        
                
                        <div style="display: flex; justify-content: center; gap: 40px; font-weight: 500; margin: 10px 0; cursor: pointer;">
                            <span class="appointment-tab active" onclick="selectTab(this, 'pendingrepos')">Pending</span>
                            <span class="appointment-tab" onclick="selectTab(this, 'completereports')">Completed</span>
                        </div>
                    </div>
                        
                
                        <div style=" overflow-y: auto; padding: 5px;;">
                            <div class="reportschedules" style=" display: flex; flex-direction: column; gap: 15px; padding: 5px; ; background-color: rgb(248, 248, 248); overflow-y: auto;"></div>
                            
                        </div>
                    </div>
                </div>
                
                        

                   
                </div>

            <!-- </div> -->

            <div class="my-calendar" >
                <div style="font-size: 18px; font-weight: bold;color: #2c3e50; padding: 12px 20px; text-align: center;  border-radius: 8px; box-shadow: 2px 4px 6px rgba(0, 0, 0, 0.1);text-transform: uppercase;letter-spacing: 1px;">
                Set Appointment Date
            </div>
            
                <div id=calendar style="display:flex;margin: 10px;padding: 10px; background-color: white;border-radius: 12px;height: 100px;"></div>

                <div id="bookdoc" style="display: none; flex-direction: column; background-color: white; padding: 10px; margin: 5px; border-radius: 12px; width: 100%; max-width: 350px;">
                    <div id="checktitle" style="margin-bottom: 10px;margin-top: 8px;">  Pick which session you would be available</div>
                  
                    <!-- Checkboxes -->
                    <label style="display: flex; align-items: center; margin-bottom: 5px;">
                        <input type="radio" id="morning" name="session" class="session-checkbox"  value="Half Day" style="margin-right: 8px;" required> 
                        Half Day
                    </label>

                    <label style="display: flex; align-items: center; margin-bottom: 10px;">
                        <input type="radio" id="fullday" name="session" class="session-checkbox"  value="Full Day" style="margin-right: 8px;" required> 
                        Full Day
                    </label>
                
                    <!-- Input for number of patients -->
                    <input type="number" id="numPatients" placeholder="Number of patients" style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%; box-sizing: border-box; margin-bottom: 10px;" required>
                    <label for="session-time">Select Time:</label>
                   <div class="input-container" style=" display: flex;align-items: center; gap: 10px;border: 1px solid #ccc;padding: 5px; width: fit-content;">
                        <input type="time" id="session-time" style=" border: none;outline: none;font-size: 16px;padding: 5px;" required>
                         <svg style="cursor: pointer;" class="add-button" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M11 8C11 7.44772 11.4477 7 12 7C12.5523 7 13 7.44772 13 8V11H16C16.5523 11 17 11.4477 17 12C17 12.5523 16.5523 13 16 13H13V16C13 16.5523 12.5523 17 12 17C11.4477 17 11 16.5523 11 16V13H8C7.44771 13 7 12.5523 7 12C7 11.4477 7.44772 11 8 11H11V8Z" fill="#0F0F0F"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M23 12C23 18.0751 18.0751 23 12 23C5.92487 23 1 18.0751 1 12C1 5.92487 5.92487 1 12 1C18.0751 1 23 5.92487 23 12ZM3.00683 12C3.00683 16.9668 7.03321 20.9932 12 20.9932C16.9668 20.9932 20.9932 16.9668 20.9932 12C20.9932 7.03321 16.9668 3.00683 12 3.00683C7.03321 3.00683 3.00683 7.03321 3.00683 12Z" fill="#0F0F0F"/>
                    </svg>
                      </div>
                    <!-- Button -->
                    <button class="session-button" style="padding: 10px; background-color: #007BFF; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 16px;">
                        Set Appointment
                    </button>
                </div>
                

            </div>
            </div> 
        
              
       <!-- Modal (Report Popup) -->
<div id="reportModal" class="modal" style="z-index:110; display: none;">
    <div class="modal-content">
        <!-- Header Section with Logo Placeholder and Date -->
        <div class="modal-header report-header">
            <h2>Afyasphere</h2> <!-- Logo Placeholder -->
            <!-- <p ><strong>Date:</strong> <span id="reportDate">4th March 2025</span></p> -->
         
        </div>

        <!-- Scrollable Modal Body 
           <p id="docsasses">${report[0].doctor.assessment} </p>
