}
        .fc-daygrid-event {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    font-size: 10px;
    padding: 2px;
    border-radius: 3px;
    color: white !important;
    text-align: center;
    width: 90%; /* Prevent Overflow */
   }


        .fc-toolbar{
           
            color: rgb(1, 1, 36);
            font-size: 12px;
        }

        .fc-toolbar-title{
            font-size: 14px;
            color:rgb(40, 41, 4);
            /* font-weight:600px */
        }
        .fc-button{
       
            background-color: rgb(252, 253, 253) !important;
            color: rgb(1, 1, 36) !important;
            border: 1px solid #b0b0a0;
            /* border:2px solid #f7f7f7; */
            border:none;

           

        }
        .selected-date{
            background-color: aquamarine !important;
            border-radius: 5px;
        }
        .fc-daygrid-day{
         
            border:none
   
        }.fc-day-today {
          background-color: rgb(190, 187, 190)!important; /* Change background color */
          color: rgb(35, 64, 66) !important; /* Change text color */
          border: 2px solid rgb(4, 46, 100) !important; /* Add a border */
          font-weight: bold !important;
         
        }
        .fc-daygrid-day-frame {
            height: 55px !important;
            width:auto;
            /* min-height: 8px !important; Set a flexible minimum height */
            display: flex;
            flex-direction: column;
            /* align-items: center;
            justify-content: center; */
        }
        /* Ensure rows are flexible */
        .fc-daygrid-day {
            height: 100% !important;
        }
        
       
        .fc-col-header-cell {

         color:black!important; /* Change text color */
         font-weight: 400px !important;
         /* text-transform: uppercase;*/
          }

        .svg-class{
            display: flex;
            margin:5px; 
            align-self:center;
            align-items: center;
            gap:10px;
            /* margin-left: 70px; */
            
        }


        .session-button{
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 5px;
        
            margin: 5px;
            font-size: 15px;
            cursor: pointer;
            border: 1px solid rgb(24, 1, 34,0.7);  
            margin-top: 20px;
            border-radius: 15px;
            background-color: rgb(43, 58, 122);
            color:white;
            border-radius: 10px;
            width: 200px;
            margin-left: 100px;
        }

        .patient-container{
            align-items: center;
            display:flex;
            flex-direction: row;
            align-items: center;
            padding: 5px;
            border-bottom: 1px solid rgb(151, 150, 150);
            padding: 5px;
            margin:3px;
        }
        
        .the-card{
            display: flex;
            flex-direction: column;
            margin: 10px;
            padding: 10px;
            border-radius: 14px;
            box-shadow: 0 2px 4px rgb(49, 40, 40) ;
            width: auto;
            height: 80px;
        }
     
   /* Modal Overlay */
.modal {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
  
    /* justify-content: center;
    align-items: center; */
}

/* Modal Content */
.modal-content {
    background: white;
    width: 50%;
    height: 94vh;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.3);
    overflow: hidden; /* Prevents content from overflowing */
    margin: 10px;
    padding:10px;
}

/* Sticky Header */
.modal-header {
    position: sticky;
    top: 0;
    background: white;
    padding: 15px 20px;
    border-bottom: 2px solid #ddd;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
    
}

/* Scrollable Modal Body */
.modal-body {
    overflow-y: auto;
    overflow-x: hidden;
    flex-grow: 1; /* Enables scrolling inside modal */
    padding: 10px;
    max-height: 70vh; /* Ensures the body is scrollable */
}

.modal-footer {
    position: sticky;
    bottom: 0;
    background: white;
    border-top: 1px solid #ddd;
    padding: 10px;
}


/* Close Button */
.close {
    cursor: pointer;
    font-size: 20px;
    font-weight: bold;
}

/* Sections */
.section {
    margin-top: 15px;
}

/* Textareas */
textarea {
    width: 90%;
    min-height: 80px;
    margin-top: 5px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    resize: none;
}

.active{
    background-color: azure;
    font-size: 18px;

}

.closed{
    background-color: rgb(231,231,231);
    font-size:17px

}
.view-report{
    margin-top: 15px;
    color: rgb(5, 63, 102); 
    background-color: rgb(221, 219, 217); 
    width: 100px;
    border-radius: 5px;
    align-items: center;
    justify-content: center;
    display: flex;
    padding: 3px; 
    cursor:pointer;
    align-self: center;
    margin: 5px;
}
/* Buttons */
button {
    padding: 10px 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    background: #007bff;
    color: white;
}

button:hover {
    background: #0056b3;
}


    .appointment-tab {
        padding: 5px 8px;
        border-radius: 8px;
        transition: all 0.3s ease-in-out;
    }

    .appointment-tab:hover {
        background: #e0f7fa;
        color: #00796b;
    }

    .appointment-tab.active {
        background: #e0f7fa;
        color: #00796b;
    }
    .completeappointment{
        display:flex;
        align-items: center;
        cursor:pointer
    }

    .completeappointment:hover::after {
    content: 'Mark as complete';
    position: absolute;
    bottom: -25px;
    left: 0;
    background-color: #333;
    color: white;
    padding: 5px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.2);
     }




    </style>

                <script src="https://cdn.jsdelivr.net/npm/date-fns@latest"></script>
                <script src='https://cdn.jsdelivr.net/npm/fullcalendar/index.global.min.js'></script>
                
                <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
                <!-- FullCalendar CSS and JS -->
                <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
                
