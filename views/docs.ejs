        /* Default Profile Container (Ensures div always has a size) */
.profile {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-position: top center;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* No Image Available - Show Initials */
.no-image {
    width: 30px;
    height: 30px;
    background: linear-gradient(135deg, #4A90E2, #1E3A8A); /* Gradient Background */
    color: white;
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
}


        .calendar{
            margin:10px;
            padding: 10px;
            width:35%;
            /* position: fixed; */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-self: center;
            max-height:350px !important;
            margin-top: 19px;
            margin-left:15px ;
