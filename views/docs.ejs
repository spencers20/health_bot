                </svg>
            
                <!-- Warning Message -->
                <p style="margin: 0; color: #721c24; font-weight: bold;">
                    Editing the report will overwrite your initial recommendation or assessment.
                </p>
            </div>
            
            
            <button id="report-submit" style="margin-top: 8px;">Send Report</button>
        </div>
  
     </div>

     <div class="modal-content">
        <div class="modal-header modal-histo">
            <h2></h2> <!-- Logo Placeholder -->
         
        </div>
        <div class="histories" style="margin: 5px;">
            
        </div>


     </div>

</div>

        
