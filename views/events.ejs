    }
        .tittlebar{
            display:flex; 
            top:1px; 
            width:100% ; 
            height: 60px;
            background-color:rgb(187, 245, 235);
            justify-content: center; 
            align-items: center;
            position: sticky;

        } 
        .e-sidebar{
            margin-top:30px; 
            margin-left: 20px; 
            display:flex; 
            flex-direction:column;
            width:17%; 
            position:fixed;
            height:450px;
            background-color:aliceblue;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
