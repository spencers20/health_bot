<header style="display: flex;background-color: rgb(235, 234, 234);top: 0;height: 70px;padding: 5px;margin: 5px;align-items: center;position: sticky;z-index: 100;gap: 80%;">
    <div style="font-size: 18px; font-weight: bold; color: #2c3e50;">AFYASPHERE</div>
    <div style="display: flex; align-items: center;">
        <div class="user-profile" style="margin: 5px; padding: 3px; border-radius: 50%; cursor: pointer; height: 40px; width: 40px; margin-right: 15px; background-color: #b7c3c7; display: flex; justify-content: center; align-items: center;">
            <span class="user-initials">--</span>
        </div>
        <span class="logout-btn" style="font-size: 14px; color: #082a4b; font-weight: 600; background-color: #f2f2f2; padding: 8px 12px; border-radius: 5px; cursor: pointer; transition: background-color 0.3s, color 0.3s;" 
            onmouseover="this.style.backgroundColor='#2c3e50'; this.style.color='#ffffff';" 
            onmouseout="this.style.backgroundColor='#f2f2f2'; this.style.color='#2c3e50';"
            onclick="logout()">
            Log Out
        </span>
    </div>
</header>
