<html lang="en">
<head>
   <style>
    .header{
        top:0;
      
        width: 100%;
        min-height: 200px;
        background-color: rgb(248, 248, 248);
        /* display: flex; */
        /* flex-direction: column; */

   

    }
    .header_container{
        width:100%;
        height:60px;
        display:flex;
        justify-content: center;
        align-items: center;
        background-color:rgb(248, 200, 200);
        /* position: absolute; */
    }
    .infoheader{
        position:absolute;
        /* background-color: aquamarine; */
        width:50%;
        height:70px;
        margin-left:25%;
        display:flex;
        align-items:center;
        justify-content:space-between;

      

    }
    .filter{
        position:absolute;
        /* background-color: rgb(173, 143, 223); */
        width:50%;
        min-height:70px;
        margin-left:25%;
        margin-top: 70px;
    
      
    }
    .filtercontainer{
        display:flex;
        /* min-height:40px;  */
        /* width: 50px; */
      
        /* background-color: rgb(207, 203, 203); */
        flex-direction:column;
        margin-right:20px;
       
            /* align-items: center;
            justify-content: center; */
        position: relative;
        

    }
    .entries{
        /* display:flex; */
        /* margin-top:5px; */
        width:100%;
        /* flex-direction: column; */



    }
    .entry_history{
        background-color: azure; 
        display:flex;   
        width:60% ;
        margin-left:20% ; 
        margin-top:5px;
        border-bottom:1px solid rgb(211, 208, 208);
        min-height:50px
    }
    .entrydetails{
        display:flex;
        flex-direction:column;
    }


   </style>
</head>
<body>
    
    <div class="header">
        <div class="header_container">
            <p style="font-size:25px; font-weight: bold;">Myafya365</p>
        </div>
        <div class="infoheader">
            <div style="display: flex; flex-direction: column; left:5px ; margin-bottom: ;">
                <span style="font-size: 22px; font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;">Spencers Journal</span>
                <div style=" display: flex;margin-top: 0px;">
                    <span style="border-right-style: solid; border-right-width:thin ">
                       <span style="margin-right:4px;">3 total entries</span> 
                    </span>
                    <span id="currentdate" style="margin-left:4px;"></span>

                </div>
                 
            </div>
            <div style="display: flex;  right:5px">
                <!-- download svg -->
                <span style="margin-right: 5px;cursor: pointer;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M8 10C8 7.79086 9.79086 6 12 6C14.2091 6 16 7.79086 16 10V11H17C18.933 11 20.5 12.567 20.5 14.5C20.5 16.433 18.933 18 17 18H16.9C16.3477 18 15.9 18.4477 15.9 19C15.9 19.5523 16.3477 20 16.9 20H17C20.0376 20 22.5 17.5376 22.5 14.5C22.5 11.7793 20.5245 9.51997 17.9296 9.07824C17.4862 6.20213 15.0003 4 12 4C8.99974 4 6.51381 6.20213 6.07036 9.07824C3.47551 9.51997 1.5 11.7793 1.5 14.5C1.5 17.5376 3.96243 20 7 20H7.1C7.65228 20 8.1 19.5523 8.1 19C8.1 18.4477 7.65228 18 7.1 18H7C5.067 18 3.5 16.433 3.5 14.5C3.5 12.567 5.067 11 7 11H8V10ZM13 11C13 10.4477 12.5523 10 12 10C11.4477 10 11 10.4477 11 11V16.5858L9.70711 15.2929C9.31658 14.9024 8.68342 14.9024 8.29289 15.2929C7.90237 15.6834 7.90237 16.3166 8.29289 16.7071L11.2929 19.7071C11.6834 20.0976 12.3166 20.0976 12.7071 19.7071L15.7071 16.7071C16.0976 16.3166 16.0976 15.6834 15.7071 15.2929C15.3166 14.9024 14.6834 14.9024 14.2929 15.2929L13 16.5858V11Z" fill="#000000"/>
                        </svg>
                <!-- new entry svg -->
                </span>
                <span style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="30px" height="30px" viewBox="0 0 24 24">
                        <path d="M5,22H19a1,1,0,0,0,1-1V6.414a1,1,0,0,0-.293-.707L16.293,2.293A1,1,0,0,0,15.586,2H5A1,1,0,0,0,4,3V21A1,1,0,0,0,5,22ZM9,11h2V9a1,1,0,0,1,2,0v2h2a1,1,0,0,1,0,2H13v2a1,1,0,0,1-2,0V13H9a1,1,0,0,1,0-2Z"/>
                    </svg>
                </span>
            </div>


        </div>
        <div class="filter" style="display: flex;">
            
            <div class="filtercontainer"id="entriestype" >
                <div style="margin-top:0px; margin-left:20px ; font-size: 18px;">entry type</div>
                <div style="cursor: pointer; border: 1px solid black ; padding:5px; display: flex; justify-content: space-between; width:150px ;  margin-top:10px;  background-color: rgb(235, 235, 235);"> 
                   <div style="display:flex; flex-direction: column;position:relative;width:100% ">
                    <span id="allentries" style=" background-color: azure; ">all entries</span>
                    <span id="symptoms" style="margin-top: 5px; display:none   ">symptoms diary</span>
                    <span  id = "checkups" style="margin-top: 10px; display:none">daily diary</span>

                   </div>
                   <div style=" margin-right:3px ; margin-top: 5px;">
                    <svg class="v-icon" width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 16L6 10h12L12 16z" fill="black"></path>
                    </svg>
                </div>
                
                </div>

            </div>
            

           <div class="filtercontainer" id="duration" >
            <div style="margin-top:0px; margin-left : 20px ;font-size: 18px; ">since</div>
            <div style="cursor: pointer; border: 1px solid black ; padding:5px; display: flex; justify-content: space-between; width:150px ;  margin-top:10px;  background-color: rgb(235, 235, 235);"> 
               <div style="display:flex; flex-direction: column;position:relative;width:100% ">
                <span id="alltime" style=" background-color: azure; ">all time</span>
                <span  id = "weektime" style="margin-top: 10px; display:none">last 7 days</span>
                <span  id = "monthtime" style="margin-top: 10px; display:none">last 30 days</span>
                <span  id = "yeartime" style="margin-top: 10px; display:none">last 1 year</span>
                <span  id = "customtime" style="margin-top: 10px; display: none; ">custom</span>

                </div>
                <div style=" margin-right:3px ; margin-top: 5px;">
                    <svg class="v-icon" width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 16L6 10h12L12 16z" fill="black"></path>
                    </svg>
                </div>

            </div>
            </div>

            <div class="filtercontainer" id="entryclassification" >
                <div style="margin-top:0px; margin-left: 20px; font-size: 18px;">entry classification</div>
                <div style="cursor: pointer; border: 1px solid black ; padding:5px; display: flex; justify-content: space-between; width:150px ;  margin-top:10px; background-color: rgb(235, 235, 235);"> 
                   <div style="display:flex; flex-direction: column;position:relative;width:100% ">
                    <span id="allentry" style=" background-color: azure; ">all entries</span>
                    <span  id = "starred" style="margin-top: 10px; display:none ">starred entry</span>
                    <span  id = "bin" style="margin-top: 10px; display:none ">archived entry</span>
                    
    
                    </div>
                    <div style=" margin-right:3px ; margin-top: 5px;">
                        <svg class="v-icon" width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 16L6 10h12L12 16z" fill="black"></path>
                        </svg>
                    </div>
    
                </div>
                </div>
    
            

        </div>
      
        
    
        </div>
        
   
    <div class="entries" style="margin-top:10px; width:100%; ">
        <div id="selection" style ="background-color: rgb(195, 195, 231);display: flex; width: 60%; margin-left: 20%; border-bottom: 1px solid black; min-height:50px; display:none ">
            <div style="margin-top:10px">
                <span style="font-size: 18px; "> 5 selected entries</span>
            </div>

            <div style="cursor: pointer; margin-left:400px;margin-top:10px">
                
                <!-- starrred svg -->
