            <input id="checkbox"  style="margin-bottom:5px" id="checkbox" type="checkbox">
            <div class="entrydetails" >
                <span id="tittle" style="margin-left: 20px; margin-bottom:5px">tittle</span>
                <span id="description" style="margin-left: 20px; margin-bottom:5px">description</span>
            </div>
            
            <span style="margin-left: 500px; margin-bottom:5px">Date</span>
            </div> -->


    </div>

    

