<!DOCTYPE html>
<html>
    <head>
        <style>
            body {
                overflow:hidden;
                display: flex;
                height: 100vh;
                background-color: #f5f5f5; 
            }

            .sidebar {
                height: 100%;
                width:250px;
                position: fixed;
                z-index: 1;
                top: 0;
                right: 0;
                background-color: #e4ecec;
                overflow-x: hidden;
                padding-top: 20px;
              }
              .sidebar h1{
                color: white;
                margin-left: 20px;
            }
            .container {
                background-color: white;
                top:15%;
                bottom:15%;
                left:8%;
                right:25%;
                shape-outside: margin-box;
                overflow:hidden;
                position:fixed;
                display:flex;

            }
            


            .containerheader {
                position: absolute;
                top: 35px; /* Distance from the top */
                width: 100%; /* Length of the line */
                height: 2px;
                background-color: black;
    
                 /* Center line horizontally */
            }

            .headers {
                position:absolute;
                top:0;
                width:100%;
                justify-content:space-around;
                font-size: 16px;
                display:flex;

            }
            .h1 {
                position:absolute;
                text-align: center;
                width:100%;
                top:50px;
                
            }
            .checksymptom ,.symptomchecked{
                position:absolute;
                top:50px;
                width:100%;
               }
            /* .symptomconfirm {
                position :absolute;
                left:60px;
                width :40%;
                background-color: aliceblue; 
                top: 180px;
                
            } */
            .symptms {
        align-self: flex-start;
        /* background-color:#fcfdf9 ; */
        margin: 0;
        padding: 0;
        line-height: 1.5;
        font-size: 16px;
        /* border-radius:  5px;
        max-width: 95%; */

       }

       .results,.aboutsymptom {
        align-self: flex-start;
        margin-top: 5px;
        margin:0;
        line-height: 1.5;
        font-size: 16px;
       }

            </style> 

    </head>
    <body>
        <div>
            <h1>Symptoms</h1>
        </div>
        <div class="sidebar">
            <h1>symptoms</h1>
        </div>

        <div class="container">
            <div class="containerheader"></div>
            <div class="headers">
                <p onclick="document.getElementById('information').style.visibility='visible', document.getElementById('symptoms').style.visibility='hidden'">INFO</p>
                <p onclick="document.getElementById('information').style.visibility='hidden', document.getElementById('symptoms').style.visibility='visible'">SYMPTOMS</p>
                <p>CONDITION</p>
                 <!-- <p>TREATMENT</p> -->
            </div>
            <div  id="information" style="visibility: hidden;">
            <div  class="h1">
                <p style="font-size: 30px; "> MYHC Symptom checker</p>
                <p style="font-size: 18px; " >Identify potential health conditions and corresponding treatments based on your symptoms</p>
                <p style="font-size:13px"> This tool is not a replacement for professional medical advice. </p>

            </div>
            <div style="width:70%; display:flex; justify-content: center; gap: 20px; text-align: center; bottom:200px; position:absolute">
                <p style="font-size:18px ;left : 20px" >Age</p>
                <input type="text" style="width:10% ; height: 50px; font-size: 16px; text-align: center;">
                <p style="font-size:18px">Gender</p>
                <button id="male" style="width: 80px; height: 50px; background-color: rgb(223, 255, 255);" onclick="this.style.backgroundColor = 'rgb(169, 240, 240)' ">Male</button>
                <button id="female" style="width: 80px; height: 50px;background-color: rgb(223, 255, 255);" onclick="this.style.backgroundColor = 'rgb(169, 240, 240)'">Female</button>
            </div>
        </div>
        <div id="symptoms" style="visibility: hidden;">
            <div class="checksymptom">
                <p style=" text-align:center; font-size:20px" > CHECK SYMPTOMS</p>  
                <div style ="width:100%">
                <input id ="symptominput" type="text" placeholder="symptoms" style="position:absolute; left:60px; width:40%; height: 80px;">
                <div style=" flex-direction: column ; position: absolute ;width:40% ; right: 50px; ">
                <div class="conditions" style=" align-items: flex-start; max-height: 300px; background-color:  #edeeee; display:flex; overflow-y: auto; overscroll-behavior: contain; ">
                   <p id="managesymptomtittle" style=" text-align:center; font-size:20px ;margin-bottom: 5px" >MANAGE YOUR SYMPTOMS </p>
                </div>
                <div id="moreinfo" style=" visibility:hidden;margin-top:  10 px;font-size: 20px; right: 30px;color: #87dfdf;">more information</div>
                </div>
            </div> 
            
            <div class="symptomconfirm" style="position :absolute;left:60px;width :40%;background-color: aliceblue; top: 180px; ">
                <!-- <p style=" text-align:center; font-size:20px" >CHECK SYMPTOMS</p> -->
                <button id="checkbtn" style="visibility: hidden; position: absolute;right:60px;  width:20%; height: 40px; margin-top: 10px;">CHECK</button>
                
            </div>
            
            

            </div>

        </div>

        <div id="condition" style="visibility: hidden;">
            <div class ="symptomchecked" style="width:70%; left:30px; position: absolute; display:flex ;flex-direction: column; ">
                <div id="checkedsymptoms"> SYMPTOMS:</div>
                 <!-- <input type="text" id="symptominput2" placeholder="symptoms"> -->
                <div class="moreinformation" style="background-color: #87dfdf;  align-items: flex-start; max-height: 300px ;margin-bottom: 10px;overflow-y: auto; overscroll-behavior: contain; margin-top: 10px">
                    <!-- Headaches can be caused by a variety of factors, including stress, poor posture, skipping meals, dehydration, and hormonal changes. There are several types of headaches, including tension headaches, migraines, and medication-overuse headaches. For tension headaches, you can try the following management strategies: * Rest and relaxation techniques * Painkillers such as paracetamol or ibuprofen * Drinking plenty of fluids to stay hydrated * Removing any stressors or triggers that may be contributing to the headache For migraines, you can try the following management strategies: * Rest and relaxation techniques * Painkillers such as triptans or ergots to help relieve pain and other symptoms * Avoiding triggers that may contribute to migraines, such as certain foods or stress * Drinking plenty of fluids to stay hydrated For medication-overuse headaches, you can try the following management strategies: * Stopping the medication that is causing the headache * Gradually reducing the dose of the medication to help prevent rebound headaches * Drinking plenty of fluids to stay hydrated * Engaging in relaxation techniques to reduce stress and anxiety It's important to note that headaches can be a symptom of an underlying medical condition, so if you're experiencing frequent or severe headaches, it's a good idea to speak with a healthcare professional to rule out any underlying issues. Please consult a doctor for further assistance. -->
                </div>
                <p  id='relatdconditions'style="font-size:16px ; margin-top: 10px; text-align: center;  visibility:hidden">related diseases</p>
                
            </div>

        </div>

        </div>
        <script src="/symptomscript.js"></script>


    </body>
</html>