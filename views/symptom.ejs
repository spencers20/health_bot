        <textarea class="chat-textarea" placeholder="Ask about your health condition " style="width: 80%;height: 60px;padding: 10px;border: none;background-color: #e0e2e2;outline: none; border-radius: 15px;font-size: 15px;color: #333;box-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.1);resize: none;">
    </textarea>
      </div>
    </div>
    
            
    

