                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <!-- Third Line -->
                        <line x1="4" y1="17" x2="20" y2="17"></line>
                      </svg>
        
                      <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;cursor: pointer;align-self: center; " > Health Records</span>
                </span>
        
            
            
                   
            </div>


            <div class="inside-container">
                <div style="top:0;background-color: white;position: sticky;z-index: 100;" >
                    <div class="headers" >
                        <p id="infos" style="cursor: pointer; font-weight: bold;" 
                        onclick="
                        // changepage('information')
                        document.querySelector('.information').style.display='flex',
                         document.querySelector('.symptoms').style.display='none' ,
                         document.querySelector('.condition').style.display='none', 
                         document.getElementById('checkbtn').style.visibility='hidden'
                         ">
                         
                         INFO</p>
                        <p style="cursor: pointer; font-weight: bold;" 
                           onclick="
                        //    changepage('symptoms')
                                   document.querySelector('.information').style.display='none'; 
                                    document.querySelector('.symptoms').style.display='flex';
                                    document.querySelector('.condition').style.display='none';
                                    ">
                            SYMPTOMS
                        </p>
                        <p style="cursor: pointer; font-weight: bold;" 
                           onclick="
                        //    changepage('condition')
                           document.querySelector('.information').style.display='none'; 
                                    document.querySelector('.symptoms').style.display='none';
                                    document.querySelector('.condition').style.display='flex';
                                    ">
                            MEDCHAT
                        </p>
                    </div>
                </div>
            
                <div class="page information" style="display: flex; text-align: center;">
                    <h1 style="font-size: 32px; font-weight: bold; margin-bottom: 10px;">Symptom Checker</h1>
                    <p style="font-size: 18px; color: #555;">Identify potential health conditions and corresponding treatments based on your symptoms.</p>
                    
                    <div style="margin-top: 20px;">
                        <div style="display: flex; flex-direction: row; align-self: center; align-items: center; justify-content: center;margin-left: 50px;">
                        <p style="font-size: 15px; color: #777;">This tool is not a replacement for professional medical advice.</p>
                        <span id="readmore"  style="cursor: pointer;">read more </span>
                        </div>
                        <div id="disclaimer" style="font-size: 14px; color: #999; margin-top: 10px; line-height: 1.5;display: none;">
                            <p>
                                This tool is not intended to be a substitute for professional medical advice. <br>
                                Always seek the advice of your physician or other qualified health provider <br>
                                with any questions you may have regarding a medical condition. <br>
                                Never disregard professional medical advice or delay in seeking it! <br>
                                If you think you may have a medical emergency, call your doctor or 911 immediately. <br>
                                Reliance on any information provided by this tool is solely at your own choice.
                            </p>
                        </div>
                    </div>
               
            
                <div style="width: 100%; display: flex; justify-content: center; gap: 20px; text-align: center; margin: 10px 0;">
                    <p style="font-size: 14px;">Do you want to save your search?</p>
                    <label>
                        <input id="yes" type="checkbox">
                        <span style="margin-left: 5px;margin-top: 20px; ">Yes</span>
                    </label>
                    <label>
                        <input id="no" type="checkbox">
                        <span style="margin-left: 5px;margin-top: 20px;">No</span>
                    </label>
                    <button  class="symptombuttons" id="continue" style="padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer;">
                        Continue
                    </button>
                </div>
            </div>
            
            
            
            
                <div class="page symptoms" style="width:100% ;gap:10px;  display:none; flex-direction: row;overflow-y: auto;">
                    
                    
                    <div id="symptom-left-side" style="width:40%; flex-direction: column; top:20px;position: sticky; z-index: 100;max-height: 80vh; ">
                        <input id ="symptominput" type="text" placeholder="symptoms" >
                        <!-- <p style=" text-align:center; font-size:20px" >CHECK SYMPTOMS</p> -->
                        <div class="symptomconfirm" style=" display:none; margin-left:30px; width :100%;background-color: rgb(211, 214, 218); padding:10px;margin:10px;color:#333;border-radius: 5px;  ">
                            
                            <!-- svg icon for clearing  'x' -->
                           <div class="clear-icon" style="display: none;"> 
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                                    <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                            </div> 
            
                        </div> 
                        <div id=buttons style="flex-direction: row; gap: 30px; width:100%;margin-top:10px ; margin-left:30px ; margin-bottom: 20px;">
                          <button class="symptombuttons"  style="height: 40px ;width:25% ;" onclick="document.querySelector('.information').style.display='block', document.querySelector('.symptoms').style.display='none' ,document.querySelector('condition').style.display='none', document.getElementById('checkbtn').style.display='none'" >BACK</button>
                          <button class="symptombuttons"  id="checkbtn" style="visibility:hidden; margin-left:10px;height: 40px ;width:25%">CHECK</button>
                       </div>

                    </div>
                    <div id="symptom-right-side" style="width :60%; margin-right:3px ; flex-direction: column; padding:10px;margin:10px">
                        <div style="  margin-right: 5px; width:100% " >
                            <div class="conditions" style="  flex-direction: column;  align-items:flex-start ; background-color:  #f1f7f7;border-radius: 10px; display:flex; margin-bottom: 10px;padding:10px;margin:10px">
                                <div class="genanime" style="display: flex; flex-direction: row;" ></div>   

                               <!-- <p id="managesymptomtittle" style="position: relative; text-align:center; font-size:20px ;margin-bottom: 5px" >MANAGE YOUR SYMPTOMS </p>  -->
                               
                            </div>
                            <button class="symptombuttons" id="moreinfo" style="height: 40px;display:none; cursor: pointer;margin-top:10 px;font-size: 16px; margin-left: 70px;">more information</span>
                            <p id="loadinginfo" style="visibility: hidden; color:aqua">checking information...</p>
                            </div> 
                        </div>  

                   
    
                    </div> 
    
            
    
          
                <div class ="page condition" style="display:none;height: 100%;">
                   <div class="conditionstart"  style="display: flex;">
                       <div id="condition-tittle" style="font-size: 20px; align-self:center;font-weight: 600;"> What would you like to Learn More About?</div>
                    <!-- <div style="flex-direction: row;"  > --> 
                        <div class="suggestions" style="display:flex;flex-direction: row; margin: 5px;padding: 5px;align-items: center; justify-content: center;">
                            <span class="sub-suggestion">How to dress a wound</span>
                            <span class="sub-suggestion"> Nonspecific Symptoms </span>
                            <span class="sub-suggestion"> Cold variants  </span>
    
                            </div>
                        <textarea id="symptom-textarea" placeholder="Ask about your health condition "></textarea>
                    
                    <!-- </div> -->
                </div>
            

                       <!-- FLEX GROW container for chat messages + sticky input -->
