            }
            .container {
                background-color: white;
                top:15%;
                bottom:15%;
                left:80px;
                right:30%;
                shape-outside: margin-box;
                overflow-y: scroll;
                position:absolute;
                display:flex;

            }
            


            .containerheader {
                position: absolute;
                top: 35px; /* Distance from the top */
                width: 100%; /* Length of the line */
                height: 2px;
                background-color: black;
    
                 /* Center line horizontally */
            }

            .headers {
                position:absolute;
                top:0;
                width:100%;
                justify-content:space-around;
                font-size: 16px;
                display:flex;

            }
            .h1 {
                position:absolute;
                text-align: center;
                width:100%;
                top:50px;
                
            }
            .checksymptom ,.symptomchecked{
                position:absolute;
                top:50px;
                width:100%;
               } 
