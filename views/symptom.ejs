<!DOCTYPE html>
<html>
    <head>
        <style>
            /* * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            } */
            body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f7;
        color: #333;
        height: 100vh;
        display:flex;
        flex-direction: column;
       
    }

    
    
    
    .container {
        display: flex;
        max-height: 80vh;
        width:100%;
        flex-direction: row;
        margin-top: 20px;
        
    }
  


    .inside-container {
    background-color: white;
    margin-top: 30px;
    width: 70%;
    max-height: 80vh;
    margin-left: 25%;
    flex-direction: column;
    display: flex;
    overflow-y:auto; /* Allows scrolling inside the container */
    box-shadow: 0 4px 8px rgba(60, 66, 45, 0.1);
    border-radius: 20px;
    position: relative;
}
        
    .headers {
            display: flex;
            width:98%; 
            border-top: 2px solid rgb(78, 78, 78);  
            margin-top: 20px; 
            justify-content: center; 
            gap: 40px; 
            padding: 10px;
            /* position: sticky; */
            /* top: 20px; */
            z-index: 100;
            background-color: white;
        }
        .sidebar {
   height:450px;
   width:20%;
   position: fixed;
   z-index: 5;
   margin-top: 30px;
   background-color: aliceblue;
   overflow-x: hidden;
   box-shadow: 0 4px 8px rgba(0,0,0,0.1);
   border-radius: 12px;
   margin-left: 30px;
  }
  .sidebar h1{
    color: white;
    margin-left: 20px;
}
            

    .menu-icon{
        margin: 10px; 
        display: flex;
        flex-direction: row; 
        align-items: center;
        justify-content: center;
        padding: 10px;
        cursor: pointer;
        transition:background-color 0.3s ease;
        color: #333;

    }
    .menu-icon:hover{
        background-color: #f0f0f5;
        border-radius: 5px;
    }
            .heading1{ 
                width:100%;
                top:1px;
                position: sticky;
                background-color: rgb(187, 245, 235);
                height: 60px;
                justify-content: center;
                align-items: center;
                font-weight: 600;
                display: flex;
    
            }



          
            .information {
                /* position:relative; */
                display: flex;
                flex-direction: column;
                text-align: center;
                width:100%;
                top:50px;
                
            }
            .symptoms {
                /* position:relative; */
                flex-direction: column;
                margin-top:0px;
                width:100%;

            }

            .condition{
                /* position:relative; */
                top:50px;
                width:100%;
               } 
            
               .page{
                display: flex;
        transition:transform 1.2s ease
       }
       .off-right{
        transform: translateX(100%);
       }
       .off-left{
        transform: translateX(-100%);
        
       }
       .active{
        transform: translateX(0);
       }

               
            /* .symptomconfirm {
                position :absolute;
                left:60px;
                width :40%;
                background-color: aliceblue; 
                top: 180px;
                
            } */
            .symptms {
        align-self: flex-start;
        /* background-color:#fcfdf9 ; */
        margin: 0;
        padding: 0;
        line-height: 1.5;
        font-size: 16px;
        /* border-radius:  5px;
        max-width: 95%; */

       }

       .addsymptomss{
        display:flex;
        flex-direction: row;
        justify-content: space-between;
       }

      .aboutsymptom {
        align-self: flex-start;
        margin-top: 5px;
        margin:0;
        line-height: 1.5;
        font-size: 16px;
       }

       .results{
        margin-top:5px;
        padding:5px;
        font-size: 16px;
        line-height:1.5 ;
     

       }

       #symptominput{
        margin-left: 30px;  
        width: 80%; 
        height: 60px; 
        margin-bottom: 10px; 
        border:none;
        background-color: #dfe2dd;
        border-radius: 10px;
        color:#333;
        padding:10px;
        outline:none;
        align-items: center;
        justify-content: center;
        font-size: 17px;
       }

       #symptominput:focus{
        border-bottom: 2px solid blue;
       }

       .symptombuttons{
        padding: 10px 20px;
        background-color: #4CAF50;
        color: white; 
        border: none; 
        border-radius: 5px; 
        cursor: pointer;
       }

       .conditionstart{
        width:100%;
        /* align-items: center; */
        /* justify-content: center; */
        display:flex;
        flex-direction:column;
        padding:10px;
        margin:10px
       }

       #symptom-textarea{
        margin-top: 10px;
        height:80px;
        width:80%;
        padding:10px;
        border: none; 
        background-color: #e0e2e2;
        outline: none;
        border-radius: 15px;
        font-size: 15px;
        color:#333;
        align-self: center;
        box-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.1);
       

       }
       .sub-suggestion{
        background-color: rgb(207, 223, 219);
        font-size: 15px;
        margin-top: 5px;
        display:flex;   
        align-items: center; 
        justify-content: center;
        border-bottom:1px solid rgb(211, 208, 208);
        min-height:20px;
        border-radius: 20px;
        cursor: pointer;
        min-width:25%;
        margin-right: 10px;
        min-height: 30px;
        

       }

       .chat-area{
        
      display: flex;
      flex-direction: column;
      flex: 1; /* Expand to fill remaining vertical space */
      background-color: #fff;
      position: relative;
    
        /* position:relative */
       }
       .chat-box{
        flex: 1; /* This makes the chat area grow */
        overflow-y: auto;
        background-color: #f1f7f7;
        padding: 10px;
        display: flex;
        flex-direction: column;
      
       }

       .user-message{
         display: flex;
          align-items: center;
          margin: 5px;
          padding: 10px;
          background-color: rgb(226, 228, 227);
          font-weight: 600;
          border-radius: 10px;
          max-width: 50%;
          min-height: 30px;
          line-height: 1.6;
        

       }

       .bot-response{
        
          display: flex;
          align-items: center;
          margin: 5px;
          padding: 10px;
          /* background-color: rgb(121, 233, 177); */
          margin-top:2px;
          border-radius: 10px;
          max-width: 100%;
          /* min-height: 30px; */
          line-height: 1.6;
        

       }

       .fadedot{
        animation:fadedot 1s infinite
       }

       
       
       @keyframes fadedot{
        0%{
            opacity:0;
        }
        50%{
            opacity:1;
        }
        100%{
            opacity: 0;
        }
       }

       

            </style> 

    </head>
    <body>
    
        <div style="height: 10vh; background-color: white; position:sticky;width:100%;top:1px">
            <div class="heading1" >
                   <h1>MYAFYA</h1>
            </div>
            </div>

            
            <div class="container">
                <div class="sidebar">
                    <span class="menu-icon" style="margin-top: 50px;"  onclick="window.location.href='/user/'">
            
                        <svg  style="margin-left:20px ; " xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" viewBox="0 0 24 24" fill="none"><path d="M9 20H7C5.89543 20 5 19.1046 5 18V10.9199C5 10.336 5.25513 9.78132 5.69842 9.40136L10.6984 5.11564C11.4474 4.47366 12.5526 4.47366 13.3016 5.11564L18.3016 9.40136C18.7449 9.78132 19 10.336 19 10.9199V18C19 19.1046 18.1046 20 17 20H15M9 20V14C9 13.4477 9.44772 13 10 13H14C14.5523 13 15 13.4477 15 14V20M9 20H15" stroke="#464455" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    
                    <span  style="margin-left :10px ;font-size: 17px; margin-bottom: 10px; cursor:pointer; align-self: center;margin-right: 60px;"> Home</span>
                </span>
        
                <span class="menu-icon" onclick="window.location.href='/user/historyentry'">
                    <svg  style="margin-bottom:10px; margin-left:20px ; "xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Circle -->
                        <circle cx="12" cy="12" r="10"></circle>
                        <!-- Vertical Line of Plus -->
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <!-- Horizontal Line of Plus -->
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                      </svg>
                      <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;cursor:pointer;  align-self: center;margin-right: 10px;" > Journal Entry</span>
                </span>
                
                <span class="menu-icon" onclick="window.location.href='/user/events'">
                    <svg style="margin-left: 20px;" xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 64 64" stroke-width="3" stroke="#000000" fill="none"><path d="M36.66,54.45H8.84A2.5,2.5,0,0,1,6.35,52V12.12A2.49,2.49,0,0,1,8.84,9.63H48.68a2.49,2.49,0,0,1,2.49,2.49v22.4"/><line x1="6.35" y1="20.63" x2="51.17" y2="20.63"/><line x1="16.46" y1="9.63" x2="16.46" y2="4.63"/><line x1="40.42" y1="9.63" x2="40.42" y2="4.63"/><circle cx="45.22" cy="45.44" r="12.43"/><polyline points="45.22 36.7 45.22 45.82 49.57 49.16"/><script xmlns=""/></svg>
                      
        
                      <span style="margin-left :10px ;font-size: 17px; margin-bottom: 10px;"> Event Scheduler</span>
                      
                </span>

                <span class="menu-icon" onclick="window.location.href='/user/checkhistory'">
                    <svg style="margin-left:20px; align-self: center;"xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
