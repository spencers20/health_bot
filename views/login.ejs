<!DOCTYPE html>
<html>
    <head>
        <title>login</title>
        <style>

            body{
                display:flex;
               
                background-color: rgb(238, 243, 243);
                flex-direction: column;
                
    
            }

            .middle{
                width: 500px;
                /* height: 50%; */
                display: flex;
                flex-direction: column;
                align-self: center;
              
                
            }
            .login{
                /* width:30%; */
                display: flex;
                 margin: 10px;
                 padding: 10px;
                 box-shadow: 0 2px 4px rgb(16, 57, 59);
                 background-color: white;
                 /* margin-top: 25%; */
                 border-radius: 5px;
                 align-items: center;
                 justify-self: center;
                 flex-direction: column;

            }

            .in-put{
                width:90% ;
                align-items: center;
                padding: 5px;
                margin: 10px;
                border: none;
                outline: none;
                background-color: rgb(236, 234, 234);
                height: 30px;

            }
            .in-put:focus{
                border-bottom: 1px solid rgb(2, 77, 87);
            }
            .loginbtn{
           height: 40px;
           padding:12px;
           margin:10px;
           background-color: rgb(98, 98, 219);  
           color:white;
           border-radius: 10px;
           border: none;
           cursor: pointer; 
           font-size: 15px;
           width: 80px;
           align-self: center;
            }

            .headers{
                display: flex;
                justify-content: space-around;
                align-items: center;
                flex-direction: row;
                gap:80px
            }

        </style>

    </head>

    <body>
        <span style="margin-top: 10px;color: rgb(2, 58, 68);font-size: 19px; ">AFYASPHERE</span>
        <div class="middle">
            <div class="login sign-in" style="display: none;">
                <div class="headers"> 
                    <span>Patient</span>
                    <span>Nurse</span>
                    <span>Doctor</span>
                </div>

                <input class="in-put" style="margin-top: 30px;" type="text" placeholder="username">
                <input class="in-put"  type="password" placeholder="password">
                <a href="">Forgot password</a>
                <button class="loginbtn"> sign in</button>

            </div>

            <div class=" login sign-up">
                <!-- <div class="headers"> 
                    <span>Patient</span>
                    <span>Nurse</span>
                    <span>Doctor</span>
                </div> -->

                <input class="in-put" style="margin-top: 30px;" type="text" placeholder="Nurse number">
                <input class="in-put" type="text" placeholder="name">
                <input class="in-put" type="text" placeholder="id number">
                <input class="in-put" type="text" placeholder="email">
                <input class="in-put" type="password" placeholder="password">

                <input class="in-put"  type="password" placeholder="confirm password">
               
                <button class="loginbtn"> sign up</button>

            </div>
          
            <div style="display: flex; flex-direction: row; align-items: center;justify-content: center;">
                <span>Dont have an account? </span>
                <span style="margin: 20px; color: blue;">sign up</span>

            </div>

             

        </div>
        
    </body>

</html>