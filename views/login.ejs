<!DOCTYPE html>
<html>
    <head>
        <title>login</title>
        <style>

            body{
                display:flex;
               
                background-color: rgb(238, 243, 243);
                flex-direction: column;
                
    
            }

          
            .middle{
                width:30%;
                display: flex;
                margin: 20px;
                padding: 10px;
                box-shadow: 0 2px 4px rgb(16, 57, 59);
                background-color: white;
                 /* margin-top: 70px; */
                border-radius: 5px;
                /* overflow: auto; */
                
                flex-direction: column;
                margin-left: 35%;

            }
        

            .in-put {
                width:90% ;
                align-items: center;
                padding: 10px;
                margin: 10px;
                border: none;
                outline: none;
                background-color: rgb(236, 234, 234);
                height: 30px;

            }
            .passw {
                width:90% ;
                align-items: center;
                padding: 10px;
                margin: 10px;
                border: none;
                outline: none;
                background-color: rgb(236, 234, 234);
                height: 30px;

            }

            
            .in-put:focus{
                border-bottom: 1px solid rgb(2, 77, 87);
            }
            .loginbtn{
           height: 40px;
           padding:12px;
           margin:10px;
           background-color: rgb(98, 98, 219);  
           color:white;
           border-radius: 10px;
           border: none;
           cursor: pointer; 
           font-size: 15px;
           width: 80px;
           align-self: center;
           margin-left: 40px;
            }

            
            .headers{
                display: flex;
                /* justify-content: space-between; */
                align-items: center;
                flex-direction: row;
                margin: 20px;
                gap:120px;
                border-bottom: 1px solid rgb(217, 217, 224);
                
            }

         
            .login{
                display: flex;
                flex-direction: column;
            }

            
            .headertittles{
                cursor: pointer; 
                width: 40%;
                align-items: center;
                justify-content: center;
                display: flex;
                color:rgb(156, 154, 154);
                transition: border-bottom 0.7s ease-in-out;
            }

            .headertittles.active{
                color:rgb(2, 34, 61);
                border-bottom:1.5px solid rgb(45, 45, 102);
                font-size: 18px;

            }
            textarea {
        width: 90%;
        height: 80px;
        /* margin-top: 15px; */
        padding: 5px;
        border: 1px solid #ddd;
        border-radius: 5px;
        resize: none;
    }



        </style>

    </head>

    <body>
        <div style="margin-top: 10px; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10px; width: 100%;">
            <select name="loginparty" id="loginparty" style="padding: 8px; font-size: 16px; border-radius: 5px; border: 1px solid #187bb9;">
                <option value="personofcare">Person Of Care</option>
                <option value="doctor">Doctor</option>
                <option value="admin">Admin</option>
            </select>
            <span style="color: rgb(2, 58, 68); font-size: 22px; font-weight: bold; text-align: center; flex-grow: 1;">
                AFYASPHERE
            </span>
        </div>
        
        
        <div class="middle" >
          
            <p id="displayrole" style="font-size: 18px; color: rgb(78, 8, 105); font-weight: bold; margin-top: 10px; text-align: center;">
                Person of Care
            </p>
            
                <div class="headers"> 
                    
                    <span class="headertittles active" id="signin">Sign in</span>
                    <span class="headertittles"  id="signup" >Sign up</span>
                   
                </div>
                <form class="login sign-in"  >
                    <div id="withnurse"  style="margin-top: 10px; gap:5px; display: flex; flex-direction: row; margin: 10px;" >
                        <input id="nursepresent" style="cursor: pointer;" type="checkbox">
                        <span style="color: rgb(72, 73, 75);">I am a Nurse  </span>
                    </div>
                    <input class="in-put user-name" type="text" placeholder="username">
                    <div class="passw signinpass" style="display: flex; flex-direction: row;">
                        <input class="in-put passw-input"  type="password" placeholder="password">
                        <span class= "showhide"style="color:rgb(4, 11, 105);cursor: pointer;">show</span>
                    </div>
                    <input class="in-put" id="n-code" style="display: none;" type="text" placeholder="Nurse Code">
                  
                    <button class="loginbtn" id="signin-btn"> sign in</button>
                    <div id="loginwithgoogle"  style="display:flex;flex-direction: column;">
                        <span style="align-self: center;">or </span>
                        <div  style="display: flex;cursor: pointer;flex-direction: row; align-items: center;justify-content: center;box-shadow: 0 1px 2px rgb(39, 39, 53);width: 50%;padding: 5px;margin: 5px;border-radius: 10px;margin-left: 80px;" onclick="window.location.href='/google'"> 
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="30px" height="30px" viewBox="-0.5 0 48 48" version="1.1"><script xmlns=""/>
        
                                <title>Google-color</title>
                                <desc>Created with Sketch.</desc>
                                <defs>
                            
                            </defs>
                                <g id="Icons" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <g id="Color-" transform="translate(-401.000000, -860.000000)">
                                        <g id="Google" transform="translate(401.000000, 860.000000)">
                                            <path d="M9.82727273,24 C9.82727273,22.4757333 10.0804318,21.0144 10.5322727,19.6437333 L2.62345455,13.6042667 C1.08206818,16.7338667 0.213636364,20.2602667 0.213636364,24 C0.213636364,27.7365333 1.081,31.2608 2.62025,34.3882667 L10.5247955,28.3370667 C10.0772273,26.9728 9.82727273,25.5168 9.82727273,24" id="Fill-1" fill="#FBBC05">
                            
                            </path>
                                            <path d="M23.7136364,10.1333333 C27.025,10.1333333 30.0159091,11.3066667 32.3659091,13.2266667 L39.2022727,6.4 C35.0363636,2.77333333 29.6954545,0.533333333 23.7136364,0.533333333 C14.4268636,0.533333333 6.44540909,5.84426667 2.62345455,13.6042667 L10.5322727,19.6437333 C12.3545909,14.112 17.5491591,10.1333333 23.7136364,10.1333333" id="Fill-2" fill="#EB4335">
                            
                            </path>
                                            <path d="M23.7136364,37.8666667 C17.5491591,37.8666667 12.3545909,33.888 10.5322727,28.3562667 L2.62345455,34.3946667 C6.44540909,42.1557333 14.4268636,47.4666667 23.7136364,47.4666667 C29.4455,47.4666667 34.9177955,45.4314667 39.0249545,41.6181333 L31.5177727,35.8144 C29.3995682,37.1488 26.7323182,37.8666667 23.7136364,37.8666667" id="Fill-3" fill="#34A853">
                            
                            </path>
                                            <path d="M46.1454545,24 C46.1454545,22.6133333 45.9318182,21.12 45.6113636,19.7333333 L23.7136364,19.7333333 L23.7136364,28.8 L36.3181818,28.8 C35.6879545,31.8912 33.9724545,34.2677333 31.5177727,35.8144 L39.0249545,41.6181333 C43.3393409,37.6138667 46.1454545,31.6490667 46.1454545,24" id="Fill-4" fill="#4285F4">
                            
                            </path>
                                        </g>
                                    </g>
                                </g>
                            <script xmlns=""/></svg>
    
                            <span style="margin-left: 10px;">Continue with Google</span>
                        </div>
                    </div>
    
                </form>
    
                <form class=" login sign-up" style="display: none;">
                
    
                    <!-- <input class="in-put" style="margin-top: 10px;" type="text" placeholder="Nurse number"> -->
                    <input class="in-put fname" type="text" style="margin-top: 10px;" placeholder="full name">
                    <!-- <input class="in-put" type="text" placeholder="id number">  -->
                    <input class="in-put email" type="text" placeholder="email">
                    <span style="margin:0">
                        <p style="font-size: 12px;color: rgb(88, 88, 88);">Date of Birth</p>
                        <input class="in-put calendar" type="date" > 
                    </span>
                    <p style="margin-top: 10px;"> Choose your Gender</p>
                    <label style="display: flex; ">
                        <input  class=" gender"  type="checkbox" name="Male"   > Male
                    </label>
                    <label style="display: flex;">
                        <input  class=" gender"  type="checkbox" name="Female"   > Female
                    </label>
                    <p style="margin-top: 10px;"> Additional Information</p>
                    <textarea id="disorder" placeholder="Please indicate any form of pre-existing condition or disability and when acquired [either at birth or if not you briefly explain how you acquired]"></textarea>
                    <div class="passw" style="display: flex; flex-direction: row;">
                        <input class="in-put passw-input" id="fpass"  type="password" placeholder="password">
                        <span class= "showhide"style="color:rgb(4, 11, 105);cursor: pointer;" >show</span>
                    </div>

                    <div class="passw" style="display: flex; flex-direction: row;">
                        <input class="in-put passw-input " id="confpass" type="password" placeholder="Confirm Password">
                        <span class= "showhide"style="color:rgb(4, 11, 105);cursor: pointer;">show</span>
                    </div>

                    <!-- <span>first password should be sim</span> -->
                   
                    <button class="loginbtn signup-btn"> sign up</button>
    
                </form>
            
          
           

             

        </div>
        <script src="/login.js"></script>   
        
    </body>

</html>