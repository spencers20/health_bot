                        <label for="birthdate">Birthdate:</label>
                        <input type="date" id="birthdate" name="birthdate" required style="padding: 8px; margin-bottom: 10px; border-radius: 5px; border: 1px solid #ccc;">
                    
                        <label for="photo">Upload Photo:</label>
                        <input type="file" id="photo" name="photo" accept=".jpeg,.jpg,.png,.pdf" style="padding: 8px; margin-bottom: 10px; border-radius: 5px;">
                    
                        <button class="submit" type="button" style="background-color: #4CAF50; color: white; padding: 10px; border: none; border-radius: 5px; cursor: pointer;">Submit</button>
                    </form>
                    
    
                </div>

        </div>

       
    <script src="/admin.js"></script>
       
