    .modal-content {
        background: rgb(255, 255, 255);
        width: 60%;
        max-height: 93%;
        border-radius: 10px;
        display: flex;
        margin:5px;
        padding: 5px;
        flex-direction: column;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.3);
        overflow: hidden; /* Prevents content from overflowing */
    }

    .hidden{
        display:none
    }
    
    /* Sticky Header */
    .modal-header {
        position: sticky;
        top: 0;
        background: white;
        padding: 15px 20px;
        border-bottom: 2px solid #ddd;
        z-index: 10;
        display: flex;
        
        justify-content: space-between;
        align-items: center;
        font-weight: bold;
    }
    
    /* Scrollable Modal Body */
    .modal-body {
        overflow-y: auto;
        overflow-x: hidden;
        flex-grow: 1; /* Enables scrolling inside modal */
        padding: 20px;
        max-height: 80vh; /* Ensures the body is scrollable */
        /* background-color: aqua; */
    }
    
    .modal-footer {
        position: sticky;
        bottom: 1px;
        background: white;
        border-top: 1px solid #ddd;
        padding: 5px;
        /* max-height: 30px !important;  */
        align-items: center;
        display: flex;
        /* overflow:hidden; */
        /* background-color: #0056b3; */
    }
    
    
    /* Close Button */
    .close {
        cursor: pointer;
        font-size: 20px;
        font-weight: bold;
    }
    
    /* Sections */
    .section {
        margin-top: 15px;
        display:flex;
       flex-direction: column;
    }
    
   
    
