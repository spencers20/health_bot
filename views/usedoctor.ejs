        .doc-card {
    margin: 0;
    padding: 0;
    width: 40%;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    background-color:  #ffffff;;
    overflow-y: auto;
    overflow-x: hidden;
    margin-top: 19px;
    margin-left: 15px;
    max-height:83vh ;
    box-sizing: border-box;
    position: sticky;
}

.card-head {
    margin: 0;
    padding: 10px;
    width: 100%;
    /* background-color: #f4f4f9; */
    border-bottom: 1px solid #ccc;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    /* height: 30px; */
    z-index: 100;
    box-sizing: border-box;
}

.availability {
    display: flex;
    justify-content: space-around;
    width: 100%;
    margin-top: 5px;
    color: #333;
    font-weight: bold;
}

.doc-history {
    margin: 10px;
    
    width: 35%;
    display: flex;
    flex-direction: column;
    background-color:  #ffffff;;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    max-height: 83vh;
    overflow-y: auto;
    margin-left: 20%;
    margin-top: 20px;
    box-sizing: border-box;
}

.report-header {
    display: flex;
    flex-direction: row;
    /* justify-content: space-between; */
    gap:200px;
    padding: 5px 10px;
    border-bottom: 2px solid rgb(194, 190, 190);
    margin-bottom: 10px;
    color: #333;
    font-weight: bold;
    /* background-color: #fff; */
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.headertitles {
    color: #130101;
    /* border-bottom: 2px solid #c97474; */
    cursor: pointer;
    padding-bottom: 3px;
    margin-bottom: -2px;
    transition: color 0.3s, border-color 0.3s;
}



        .doc-details {
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    z-index: 100;
    padding: 5px;
    box-sizing: border-box;
    position: fixed;
    width: 100vw; /* Use viewport width to ensure full coverage */
    height: 100vh; /* Use viewport height for full coverage */
    display: none;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-direction: row;
    background-color: rgba(29, 27, 27, 0.9);
    margin: 0; /* Remove any default margin */
}

