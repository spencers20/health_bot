            resize: none;
            margin-top: 10px;
            height: 100px;
        }

        .session-button{
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 5px;
            border-radius: 20px;
            margin: 5px;
            font-size: 15px;
            cursor: pointer;
            border: 1px solid rgb(24, 1, 34,0.7);  
        }

        .book-button{
            margin-top: 20px;
            border-radius: 15px;
            background-color: rgb(38, 38, 153);
            color:white;
            align-items: center;
            cursor: pointer;
            border-radius: 10px;
            width: 200px;
            align-self: center;
          


        }


        .session-button:hover {
            border: none;
            color: black;
            box-shadow: 0 1px 5px rgba(110, 135, 150, 0.7); /* Valid shadow */
            background-color: rgba(110, 135, 150, 0.1); /* Slight color change on hover */
        }
       
        /* Toolbar Styling */
.fc-toolbar {
    background-color: rgb(220, 237, 245);
    color: rgb(1, 1, 36);
    font-size: 14px;
    padding: 8px;
}

.fc-toolbar-title {
    font-size: 16px;
    color: rgb(40, 41, 4);
    font-weight: bold;
}

.fc-button {
    font-size: 14px;
    background-color: rgb(180, 220, 240) !important;
    color: rgb(1, 1, 36) !important;
    border: 1px solid #b0b0a0;
    border-radius: 4px;
}

/* Highlight selected date */
.selected-date {
    background-color: aquamarine !important;
    border-radius: 5px;
}

/* General Day Styling */
.fc-daygrid-day {
    background-color: rgb(220, 237, 245) !important;
    border: none;
}

/* Highlight Today's Date */
.fc-day-today {
    background-color: rgb(162, 159, 163) !important;
    color: rgb(35, 64, 66) !important;
    border: 2px solid rgb(4, 46, 100) !important;
    font-weight: bold !important;
    border-radius: 5px;
}

/* Header (Days of the Week) Styling */
.fc-col-header-cell {
    background-color: rgb(220, 237, 245) !important;
    color: black !important;
    font-weight: bold !important;
    text-transform: uppercase;
}

/* Ensure Proper Spacing for Events */
.fc-daygrid-day-frame {
    height: auto !important;
    min-height: 20px !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Dates that have events - Change Background */
.fc-daygrid-day.has-event {
    background-color: rgba(255, 225, 132, 0.8) !important; /* Light Yellow */
    border-radius: 5px;
}

/* Style Event Text */
/* Event Styling */
.fc-daygrid-event {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    font-size: 10px;
    padding: 2px;
    border-radius: 3px;
    background-color: rgba(4, 123, 255, 0.8) !important; /* Blue */
    color: white !important;
    text-align: center;
    width: 90%; /* Prevent Overflow */
}
.fc-event-title {
    white-space: normal;
    text-align: center;
    font-size: 12px;
}
 
              

