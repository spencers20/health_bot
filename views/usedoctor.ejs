        }
    .modal-content {
        background: rgb(255, 255, 255);
        width: 60%;
        max-height: 93%;
        border-radius: 10px;
        display: flex;
        margin:5px;
        padding: 5px;
        flex-direction: column;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.3);
        overflow: hidden; /* Prevents content from overflowing */
    }

    .hidden{
        display:none
    }
    
    /* Sticky Header */
    .modal-header {
        position: sticky;
        top: 0;
        background: white;
        padding: 15px 20px;
        border-bottom: 2px solid #ddd;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: bold;
    }
    
    /* Scrollable Modal Body */
    .modal-body {
        overflow-y: auto;
        overflow-x: hidden;
        flex-grow: 1; /* Enables scrolling inside modal */
        padding: 20px;
        max-height: 80vh; /* Ensures the body is scrollable */
        /* background-color: aqua; */
    }
    
    .modal-footer {
        position: sticky;
        bottom: 1px;
        background: white;
        border-top: 1px solid #ddd;
        padding: 5px;
        /* max-height: 30px !important;  */
        align-items: center;
        display: flex;
        /* overflow:hidden; */
        /* background-color: #0056b3; */
    }

    .popup-profile{
            position: absolute;
            display: flex;
            flex-direction: column;
            top: 70px;
            right: 20px;
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            padding: 10px;
            /* display: none; */
            z-index: 110;
        }
    
    
    /* Close Button */
    .close {
        cursor: pointer;
        font-size: 20px;
        font-weight: bold;
    }
    
    /* Sections */
    .section {
        margin-top: 15px;
        display:flex;
       flex-direction: column;
    }
    
    /* Textareas */
    textarea {
        width: 90%;
        height: 80px;
        margin-top: 5px;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        resize: none;
    }
    
    /* Buttons */
    .send-doc{
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        background: #007bff;
        color: white;
    }
    
    .send-doc:hover {
        background: #011429;
    }
    .clicked-docs {
    cursor: pointer;
    font-weight: bold;
    color: #2b8a3e;            /* Green color for active look */
    background-color: #e8f5e9; /* Light green background */
    padding: 5px 10px;
    border-radius: 5px;
    transition: background-color 0.3s, color 0.3s;
}
.generating-report {
        font-family: Arial, sans-serif;
        font-size: 18px;
        color: #333;
        background-color: #f0f8ff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        width: 300px;
        text-align: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin: auto;
        position: relative;
        top: 20%;
        animation: fadeIn 1.5s ease-in-out;
    }

    @keyframes fadeIn {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }

        
        

            

